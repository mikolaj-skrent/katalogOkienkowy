<Window x:Class="katalogOkienkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:katalogOkienkowy"
        mc:Ignorable="d"
        Title="Katalog Okienkowy" Height="600" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Katalog Okienkowy" FontSize="24" FontWeight="Bold"/>
        <TextBlock x:Name="EtykietaLiczbaProduktow"  Text="Produktów: 0" FontSize="14" Margin="0,10,0,0"/>
        <TextBlock x:Name="EtykietaMagazynu"  Text="Wartość magazynu: 0" FontSize="14" Margin="0,10,0,0"/>

        <Button HorizontalAlignment="Center" Padding="5">
            <StackPanel Orientation="Horizontal">
                <Image Source="Images/plus.png" Width="16" Height="16" Margin="0,0,5,0"/>
                <TextBlock Text="Dodaj produkt" FontSize="16" FontWeight="Bold"/>

            </StackPanel>
        </Button>
                
        

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Content="Przycisk 1" Margin="5"/>
            <Button Grid.Row="0" Grid.Column="1" Content="Przycisk 2" Margin="5"/>
            <Button Grid.Row="1" Grid.Column="0" Content="Przycisk 3" Margin="5"/>
            <Button Grid.Row="1" Grid.Column="1" Content="Przycisk 4" Margin="5"/>
        </Grid>

    </StackPanel>
</Window>
